{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "cflb-alpha.vercel.app" }],
      "destination": "https://play.champagnefootball.com.au/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
